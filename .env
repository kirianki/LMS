# Core Django Settings
DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALLOWED_HOSTS=62.84.184.62,62.84.184.62:90,www.yourdomain.com,localhost,127.0.0.1,backend

# Database
DB_NAME=lms_prod
DB_USER=lms_user
DB_PASSWORD=secure_db_password
DB_HOST=db
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:70/api/v1
NEXT_PUBLIC_PRIMARY_COLOR='#2EAD8F'
NEXT_PUBLIC_SECONDARY_COLOR='#00B4C5'
# M-Pesa Settings (Optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# Email Settings (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
